# Voice Assistant local env example
# Copy the needed lines into .env.local and fill real secrets locally.
# Never commit .env.local or real API keys.

# Main path: Doubao realtime audio delta
DOUBAO_REALTIME_ENABLED=true
DOUBAO_REALTIME_ENDPOINT=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
DOUBAO_REALTIME_APP_ID=
DOUBAO_REALTIME_ACCESS_KEY=
DOUBAO_REALTIME_APP_KEY=
DOUBAO_REALTIME_RESOURCE_ID=volc.speech.dialog
DOUBAO_REALTIME_MODEL=
DOUBAO_REALTIME_VOICE=zh_female_cancan
DOUBAO_REALTIME_INPUT_AUDIO_FORMAT=pcm16
DOUBAO_REALTIME_INPUT_SAMPLE_RATE=16000
DOUBAO_REALTIME_INPUT_CHANNELS=1
DOUBAO_REALTIME_OUTPUT_AUDIO_FORMAT=ogg_opus
DOUBAO_REALTIME_OUTPUT_SAMPLE_RATE=24000
DOUBAO_REALTIME_TEMPERATURE=0.4
DOUBAO_REALTIME_MAX_TOKENS=512
DOUBAO_REALTIME_FORWARD_BINARY_PROTOCOL=false

# Fallback path: browser ASR + LLM + MiniMax high-quality TTS
VOICE_TTS_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_TTS_ENDPOINT=wss://api.minimaxi.com/ws/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=male-qn-qingse
MINIMAX_TTS_FORMAT=mp3
MINIMAX_TTS_SAMPLE_RATE=32000
MINIMAX_TTS_BITRATE=128000
MINIMAX_TTS_SPEED=0.95
MINIMAX_TTS_VOLUME=1
MINIMAX_TTS_PITCH=0
MINIMAX_TTS_CONNECT_TIMEOUT_MS=3500
MINIMAX_TTS_SYNTHESIS_TIMEOUT_MS=12000
